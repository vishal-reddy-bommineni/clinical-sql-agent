# Copy this file to .env and fill in your key. Never commit .env (it is in .gitignore).

# --- Google Gemini (default) ------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=paste-your-key-here
# Run `python -m scripts.check_llm` to list the models your key can use.
GEMINI_MODEL=gemini-flash-latest

# Free tiers allow only a few requests per minute. Lower this if you see 429 errors.
LLM_REQUESTS_PER_MINUTE=8

# --- Any OpenAI-compatible API instead (Groq, OpenAI, OpenRouter, Ollama) ----
# LLM_PROVIDER=openai_compatible
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile
